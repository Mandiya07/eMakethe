# ==========================================
# EMAKETHE V2 — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. AI ASSISTANT CONFIGURATION
# GEMINI_API_KEY: Server-side API key for Gemini 3.5 Flash product & seller coaching
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. APPLICATION BASE URL
# Used for generating WhatsApp payment links, redirect URLs, and webhook callbacks
APP_URL="http://localhost:3000"

# 3. MTN MOMO API CONFIGURATION (Server-side secrets)
# When configured, Emakethe initiates genuine USSD push and webhook verification.
# If credentials are not provided, the payment engine clearly marks the provider as "Pending Configuration".
MTN_MOMO_ENVIRONMENT="sandbox" # or "production"
MTN_MOMO_SUBSCRIPTION_KEY="YOUR_MOMO_SUBSCRIPTION_KEY"
MTN_MOMO_API_USER="YOUR_MOMO_API_USER_UUID"
MTN_MOMO_API_KEY="YOUR_MOMO_API_KEY"
MTN_MOMO_TARGET_ENVIRONMENT="sandbox" # or "live"
MTN_MOMO_CURRENCY="SZL" # Eswatini Lilangeni (SZL / E)
MTN_MOMO_CALLBACK_HOST="https://your-domain.com"

# 4. CARD PAYMENT PROVIDER CONFIGURATION (PCI-Compliant Hosted Gateway / Tokenization)
# We NEVER store card numbers, CVVs, or PINs. Payments are processed through hosted checkout sessions.
CARD_GATEWAY_PROVIDER="generic_hosted" # e.g. "paygate", "peach", "paystack", "ozow"
CARD_GATEWAY_MERCHANT_ID="YOUR_MERCHANT_ID"
CARD_GATEWAY_SECRET_KEY="YOUR_SECRET_KEY"
CARD_GATEWAY_PUBLIC_KEY="YOUR_PUBLIC_KEY"

# 5. PAYMENT WEBHOOK SECRETS
# Used to verify HMAC signatures of inbound payment webhooks
PAYMENT_WEBHOOK_SECRET="YOUR_WEBHOOK_SIGNING_SECRET"

# 6. ADMIN BOOTSTRAPPING
# Super admin email for initial system initialization and role enforcement
SUPER_ADMIN_EMAIL="siphom.yati@gmail.com"
