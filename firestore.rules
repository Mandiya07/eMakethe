rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        getUserData().role == role || 
        (getUserData().roles != null && role in getUserData().roles)
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        hasRole('SUPER_ADMIN') || 
        hasRole('ADMIN') ||
        (request.auth.token.email != null && request.auth.token.email == 'siphom.yati@gmail.com')
      );
    }

    function isSeller() {
      return isAuthenticated() && (hasRole('SELLER') || getUserData().sellerId != null);
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles']))
      );
      allow delete: if isAdmin();
    }

    // 2. Sellers collection
    match /sellers/{sellerId} {
      allow read: if true; // Public directory
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.userId == request.auth.uid) ||
        (getUserData().sellerId == sellerId)
      );
      allow delete: if isAdmin();
    }

    // 3. Products collection
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.sellerId == getUserData().sellerId) ||
        exists(/databases/$(database)/documents/sellers/$(resource.data.sellerId)) &&
        get(/databases/$(database)/documents/sellers/$(resource.data.sellerId)).data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.sellerId == getUserData().sellerId) ||
        (exists(/databases/$(database)/documents/sellers/$(resource.data.sellerId)) &&
         get(/databases/$(database)/documents/sellers/$(resource.data.sellerId)).data.userId == request.auth.uid)
      );
    }

    // 4. Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || hasRole('CONTENT_MANAGER');
    }

    // 5. Orders collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == getUserData().sellerId ||
        (exists(/databases/$(database)/documents/sellers/$(resource.data.sellerId)) &&
         get(/databases/$(database)/documents/sellers/$(resource.data.sellerId)).data.userId == request.auth.uid)
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == getUserData().sellerId ||
        (exists(/databases/$(database)/documents/sellers/$(resource.data.sellerId)) &&
         get(/databases/$(database)/documents/sellers/$(resource.data.sellerId)).data.userId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // 6. Payments collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == getUserData().sellerId
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if false; // Immutable ledger
    }

    // 7. Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (isAdmin() || resource.data.customerId == request.auth.uid);
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.customerId == request.auth.uid);
    }

    // 8. Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }

    // Fallback for public banners & promotions
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
